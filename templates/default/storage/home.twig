<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="{{url_for('static', filename=userTheme + '/css/style.css')}}">
        <title>FileShare</title>
    </head>
    <body onclick="closeAllFileOptionMenu(this)">
        <noscript><h1>PLEASE ENABLE JAVASCRIPT OR SITE MIGHT NOT WORK CORRECTLY</h1></noscript>
        {{ data['popupHTML'] }}
        <div class="coreContent prevent-select">
            <div class="leftBox">
                {{ data['navbarHTML'] }}
            </div>
            <div class="rightBox" onclick="closeAllFileOptionMenu(this)">
                <div class="topBox">
                    <div class="searhBox">
                        <div class="centerItem"><b>Search:</b>
                            <div class="searchInputBox">
                                <input id="storageSearch" class="searchInput searchPadding" type="text" autocomplete="off" onchange="filter(this)" oninput="updateMatches(this)" placeholder="Type search here"><span onclick="filter(this.parentElement)" class="roundSearchGlass"><span class="material-symbols-outlined">search</span></span>
                                <div id="searchDropdown" style="display: none;">
                                
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="rightContent">
                    <div>
                        {{ data['navHelp'] }}
                    </div>
                    <div class="uploadedItems">
                        {{data['files']}}
                    </div>
                </div>
            </div>
        </div>

        <script src="{{url_for('static', filename=userTheme + '/js/script.js')}}"></script>
    </body>
</html>