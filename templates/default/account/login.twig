<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="{{url_for('static', filename=userTheme + '/css/style.css')}}">
    <title>FileShare</title>
</head>
<body>
    <br>
    <br>
    <br>
    <div class="centerItem">
        <div class="centerItem formBox simpleShadow">
            <h3>Login</h3>
            <form method="POST">
                <label for="username">Username:</label>
                <br>
                <input name="username" class="textInputColor" type="text"></input>
                <br><br>
                <label for="password">Password:</label>
                <br>
                <input name="password" class="textInputColor" type="password"></input>
                <br><br>
                <div class="centerItem">
                    <button class="defaultButton">Login</button>
                    {% if data['toggle'] %}
                        <br><br>
                        {{data['error']}}
                    {% endif %}
                </div>
            </form>
            <br><br>
            <span>Don't have an account?</span><br>
            <a style="color: var(--fgColor);" href="/signup">Signup now</a>
        </div> 
    </div>
    <br>
    <br>
    {{ alert }}
    <script>
    if ( window.history.replaceState ) {
        window.history.replaceState( null, null, window.location.href );
    }
    </script>
    <script src="{{url_for('static', filename=userTheme + '/js/script.js')}}"></script>
</body>
</html>